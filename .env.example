# === Database ===
MONGO_URL=mongodb://localhost:27017
DB_NAME=your_database_name

# === Public URL (used for OAuth callbacks, verify links, invoice URLs) ===
NEXT_PUBLIC_BASE_URL=https://your-domain.com

# === CORS ===
CORS_ORIGINS=*

# === Auth ===
# Generate a strong random secret: `openssl rand -hex 64`
JWT_SECRET=replace-with-a-long-random-string-min-32-chars

# === Google OAuth ===
# From: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <NEXT_PUBLIC_BASE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret

# === Razorpay (Test / Live) ===
# From: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# === Emergent LLM (OpenAI-compatible, universal key for GPT/Claude/Gemini) ===
# Endpoint: https://integrations.emergentagent.com/llm/v1
EMERGENT_LLM_KEY=sk-emergent-your-key

# === Admin allow-list ===
# Comma-separated emails that are auto-promoted to admin on first login
ADMIN_EMAILS=admin@yourdomain.com

# === Optional email provider (for password reset emails) ===
# Provide ONE of these when ready. Without a key, reset link is shown inline in dev mode.
# SENDGRID_API_KEY=SG.xxx
# RESEND_API_KEY=re_xxx
